---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  hideChrome?: boolean;
  hideNav?: boolean;
}

const {
  title,
  description = 'Gravel Club Ulm – Verein für Gravel- und Radsport rund um Ulm.',
  hideChrome = false,
  hideNav = false,
} = Astro.props;

const pageTitle = title === 'Gravel Club Ulm' ? title : `${title} · Gravel Club Ulm`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    {!hideChrome && <Header hideNav={hideNav} />}
    <main id="main" class:list={{ 'site-main--full-bleed': hideChrome }}>
      <slot />
    </main>
    {!hideChrome && <Footer />}
  </body>
</html>

---
interface Props {
  hideNav?: boolean;
}

const { hideNav = false } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/touren', label: 'Touren' },
  { href: '/blog', label: 'Blog' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

  <header class="site-header">
    <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Gravel Club Ulm – Startseite">
      <img src="/favicon.png" width="42" height="42" alt="" />
      <span>Gravel Club <span>Ulm</span></span>
    </a>
    {!hideNav && (
      <nav class="site-nav" aria-label="Hauptnavigation">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    )}
  </div>
</header>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Gravel Club Ulm">
  <section class="page-header">
    <h1>Gravel Club Ulm</h1>
    <p>
      <!-- TODO: Echten Einleitungstext über den Verein ergänzen. -->
      Willkommen beim Gravel Club Ulm! Wir sind ein Verein für alle, die Gravel- und
      Radtouren rund um Ulm lieben. Hier findet ihr Infos zum Verein, unsere Touren
      und aktuelle Neuigkeiten.
    </p>
    <a class="button" href="/kontakt">Mitmachen &amp; Kontakt aufnehmen</a>
  </section>

  <section>
    <h2>Neuigkeiten</h2>
    {
      latestPosts.length === 0 ? (
        <p class="placeholder">Noch keine Beiträge vorhanden.</p>
      ) : (
        <ul class="post-list">
          {latestPosts.map((post) => (
            <li class="post-list__item">
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <p class="post-meta">
                {post.data.pubDate.toLocaleDateString('de-DE', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              {post.data.description && <p>{post.data.description}</p>}
            </li>
          ))}
        </ul>
      )
    }
    <p><a href="/blog">Alle Beiträge ansehen &rarr;</a></p>
  </section>
</BaseLayout>

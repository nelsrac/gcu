---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Gravel Club Ulm">
  <section class="page-header">
    <h1>Gravel Club Ulm</h1>
    <p>
      <!-- TODO: Echten Einleitungstext über den Verein ergänzen. -->
      Willkommen beim Gravel Club Ulm! Wir sind ein Verein für alle, die Gravel- und
      Radtouren rund um Ulm lieben. Hier findet ihr Infos zum Verein, unsere Touren
      und aktuelle Neuigkeiten.
    </p>
    <a class="button" href="/kontakt">Mitmachen &amp; Kontakt aufnehmen</a>
  </section>

  <section>
    <h2>Auf einen Blick</h2>
    <ul class="post-list">
      <li class="post-list__item">
        <h3><a href="/ueber-uns">Über uns</a></h3>
        <p>Wer wir sind und wofür der Verein steht.</p>
      </li>
      <li class="post-list__item">
        <h3><a href="/touren">Touren</a></h3>
        <p>Unsere regelmäßigen Gravel- und Radtouren rund um Ulm.</p>
      </li>
      <li class="post-list__item">
        <h3><a href="/blog">Blog</a></h3>
        <p>Neuigkeiten, Ankündigungen und Tourberichte.</p>
      </li>
    </ul>
  </section>
</BaseLayout>

---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageLayout
  title="Blog"
  description="Neuigkeiten und Tourberichte des Gravel Club Ulm."
  eyebrow="GESCHICHTEN VOM WEG"
  intro="Neuigkeiten, Ankündigungen und Tourberichte des Gravel Club Ulm."
>
  {
    posts.length === 0 ? (
      <p class="placeholder">Noch keine Beiträge vorhanden.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list__item">
            <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
            <p class="post-meta">
              {post.data.pubDate.toLocaleDateString('de-DE', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            {post.data.description && <p>{post.data.description}</p>}
            {post.data.tags && (
              <p>
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</PageLayout>
